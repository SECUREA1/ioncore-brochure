    last_transcript: str = ""
    last_keywords: List[str] = field(default_factory=list)
    last_sentiment: Dict[str, float|str] = field(default_factory=lambda: {"label":"NEUTRAL","score":0.5})
    last_seen: str = ""
    history: List[Dict] = field(default_factory=list)

@dataclass
class PeopleMemory:
    names: List[str] = field(default_factory=list)

@dataclass
class VehicleEvent:
    ts: str
    label: str
    camera: str

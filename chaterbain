    version: int = 1
    user_style: str = "playful"

class DataStore:
    def __init__(self):
        self.objects: Dict[str, ObjectRow|dict] = self._load_objects()
        self.people: PeopleMemory = PeopleMemory(**_load_json(PEOPLE_MEMORY_FILE, {"names": []}))
        self.vehicle_log: List[Dict] = _load_json(VEHICLE_LOG_FILE, [])
        self.settings: Settings = Settings(**_load_json(SETTINGS_FILE, {"version":1, "user_style":"playful"}))

    def _load_objects(self) -> Dict[str, ObjectRow|dict]:
        raw = _load_json(OBJECT_STORIES_FILE, {})
        out: Dict[str, ObjectRow|dict] = {}
        for k, v in raw.items():
            if isinstance(v, dict):
                try:
                    out[k] = ObjectRow(**v)
                except Exception:
                    out[k] = v
            else:
                out[k] = ObjectRow(count=1, last_transcript=str(v))
        return out

    def save(self):
        # objects
        ser = {}
        for k, v in self.objects.items():
            if isinstance(v, ObjectRow):
                ser[k] = asdict(v)
            else:
                ser[k] = v
        _save_json(OBJECT_STORIES_FILE, ser)
        # people
        _save_json(PEOPLE_MEMORY_FILE, asdict(self.people))
        # vehicles
        _save_json(VEHICLE_LOG_FILE, self.vehicle_log)
        # settings
        _save_json(SETTINGS_FILE, asdict(self.settings))

    # --- builders / readers ---
    def remember_object(self, name: str, transcript: str, source: str = "voice") -> ObjectRow:
        key = (name or "").lower()
        row = self.objects.get(key, ObjectRow())
        if isinstance(row, dict):  # legacy conversion
            row = ObjectRow(**row)
        row.count += 1
        row.last_transcript = transcript or ""
        row.last_keywords = extract_keywords(transcript, 6) if transcript else []
        lab, score = quick_sentiment(transcript)
        row.last_sentiment = {"label": lab, "score": score}
        row.last_seen = _now_iso()
        row.history.append({
            "ts": row.last_seen, "text": transcript or "",
            "keywords": row.last_keywords, "sentiment": row.last_sentiment,
            "source": source
        })
        self.objects[key] = row
        self.save()
        return row

    def add_known_person(self, name: str):
        if not name: return
        if name not in self.people.names:
            self.people.names.append(name)
            self.save()

    def log_vehicle(self, label: str, camera: str, note: str = ""):
        self.vehicle_log.append(asdict(VehicleEvent(ts=_now_iso(), label=label, camera=camera, note=note)))
        self.save()

    def recent_object_memories(self, n: int = 6) -> List[str]:
        items = []
        for k, v in self.objects.items():
            if isinstance(v, ObjectRow):
                items.append((v.last_seen, k, v))
        items.sort(key=lambda t: t[0], reverse=True)
        out = []
        for _, name, row in items[:n]:
            desc = f"{name}: '{(row.last_transcript or '')[:60]}'"
            out.append(desc)
        return out

    def export_all(self) -> Dict:
        return {
            "objects": {k: (asdict(v) if isinstance(v, ObjectRow) else v) for k,v in self.objects.items()},
            "people": asdict(self.people),
            "vehicle_log": self.vehicle_log,
            "settings": asdict(self.settings),
        }

    def import_all(self, payload: Dict):
        try:
            objs = payload.get("objects", {})
            self.objects = {}
            for k, v in objs.items():
                self.objects[k] = ObjectRow(**v) if isinstance(v, dict) else ObjectRow(last_transcript=str(v))
            ppl = payload.get("people", {"names":[]})
            self.people = PeopleMemory(**ppl)
            self.vehicle_log = payload.get("vehicle_log", [])
            self.settings = Settings(**payload.get("settings", {"version":1,"user_style":"playful"}))
            self.save()
        except Exception:
            pass

    def reset_database(self):
        self.objects = {}
        self.people = PeopleMemory()
        self.vehicle_log = []
        self.settings = Settings()
        self.save()

# =========================
# Tuner (knobs)
# =========================
@dataclass
class Tuner:
    # core toggles
    voice_enabled: bool = True
    narrate_persons: bool = True
    narrate_objects: bool = True
    narrate_vehicles: bool = True
    # per-label mutes
    muted_labels: set = field(default_factory=set)
    # cooldowns
    global_cooldown: float = 3.0
    per_key_cooldown: float = 10.0
    connector_min_secs: float = 2.0
    # style/sentiment
    user_style: str = "playful"            # playful | neutral | serious
    connector_nod_keywords: bool = True
    sentiment_sensitivity: float = 0.4     # how much to react to positive/negative (0..1)
    verbosity: int = 1                     # 0: terse, 1: normal, 2: chatty

    # runtime
    _last_any: float = 0.0
    _last_key: Dict[str, float] = field(default_factory=dict)
    _recent_labels: deque = field(default_factory=lambda: deque(maxlen=6))
    prev_obj: Optional[str] = None
    prev_kw: List[str] = field(default_factory=list)
    prev_sent: str = "NEUTRAL"
    last_connector_ts: float = 0.0

    # helpers
    def should_speak(self) -> bool: return self.voice_enabled
    def muted(self, label: str, kind: str) -> bool:
        l = (label or "").lower()
        if l in self.muted_labels: return True
        if kind == "person": return not self.narrate_persons
        if kind == "vehicle": return not self.narrate_vehicles
        return not self.narrate_objects
    def under_global_cd(self) -> bool: return (time.time() - self._last_any) < self.global_cooldown
    def under_key_cd(self, key: str) -> bool: return (time.time() - self._last_key.get(key, 0.0)) < self.per_key_cooldown
    def mark_any(self): self._last_any = time.time()
    def mark_key(self, key: str): self._last_key[key] = time.time()
    def seen_recent(self, label: str) -> bool:
        l = (label or "").lower()
        if l in self._recent_labels: return True
        self._recent_labels.append(l); return False

# =========================
# Witty, Vehicle, Person engines
# =========================
def witty_for_object(label: str, ds: DataStore) -> str:
    # (Optional LLM hook could be added; this module stays offline-safe.)
    fall = WITTY_FALLBACKS.get(label.lower())
    if fall: return random.choice(fall)
    return f"{label.capitalize()} spotted—want me to track it?"

def vehicle_lines(label: str) -> Tuple[str,str]:
    l = label.lower()
    pack = VEHICLE_CHATTER.get(l)
    if pack:
        return random.choice(pack["intro"]), random.choice(pack["follow"])
    return random.choice(DEFAULT_VEHICLE_INTRO), random.choice(DEFAULT_VEHICLE_FOLLOW)

def person_opening(tuner: Tuner) -> str:
    # pick from vibe guided by last sentiment + style + verbosity
    mood = tuner.prev_sent or "NEUTRAL"
    bank = PERSON_OPENERS["neutral"]
    if mood == "POSITIVE" and tuner.sentiment_sensitivity >= 0.3:
        bank = PERSON_OPENERS.get("positive", bank)
    elif mood == "NEGATIVE" and tuner.sentiment_sensitivity >= 0.3:
        bank = PERSON_OPENERS.get("negative", bank)
    if tuner.verbosity == 0:
        # shorter variants
        short = [b.split("—")[0].split("?")[0]+"?" for b in bank]
        bank = [s if s.endswith("?") else (s + "?") for s in short]
    return random.choice(bank)

# =========================
# High-level handlers (call these from your GUI loops)
# =========================
class Brain:
    """
    Public API:
      - brain = Brain(display_fn, speak_fn, listen_fn)
      - brain.on_object(label, conf, camera_name)
      - brain.on_person()
      - brain.context_summary()
      - brain.datastore (builders/readers)
      - brain.tuner (knobs)
    """
    def __init__(self,
                 display_fn: Callable[[str], None],
                 speak_fn: Callable[[str], None],
                 listen_fn: Callable[[int], str],
                 datastore: Optional[DataStore] = None,
                 tuner: Optional[Tuner] = None):
        self.display = display_fn
        self.speak   = speak_fn
        self.listen  = listen_fn
        self.ds      = datastore or DataStore()
        self.tuner   = tuner or Tuner(user_style=self.ds.settings.user_style)

        # rolling scene state for context summaries
        self.scene_labels: List[str] = []
        self.scene_counts: Dict[str,int] = {}

    # ---------- context ----------
    def update_scene(self, labels: List[str]):
        self.scene_labels = labels or []
        counts: Dict[str,int] = {}
        for l in self.scene_labels: counts[l] = counts.get(l, 0) + 1
        self.scene_counts = counts

    def context_summary(self) -> str:
        if not self.scene_labels: return "No notable objects in view."
        parts = [f"{k} x{v}" for k,v in self.scene_counts.items()]
        mems = self.ds.recent_object_memories(4)
        s = "In view: " + ", ".join(parts)
        if mems: s += ". Recent notes: " + "; ".join(mems)
        return s

    # ---------- object handler ----------
    def on_object(self, label: str, confidence: float, camera_name: str = "camera"):
        kind = "vehicle" if label.lower() in VEHICLE_LABELS else "object"
        if self.tuner.muted(label, kind): return
        key = f"{kind}:{label.lower()}"
        if self.tuner.under_key_cd(key) or self.tuner.seen_recent(label): return

        # connector
        conn = ""
        if self.tuner.prev_obj and (time.time() - self.tuner.last_connector_ts) > self.tuner.connector_min_secs:
            conn = tie_connector(self.tuner.prev_obj, label, self.tuner.prev_kw,
                                 self.tuner.prev_sent, self.tuner.user_style,
                                 nod_keywords=self.tuner.connector_nod_keywords)
            if conn:
                self.display(f"AI: {conn}")
                if self.tuner.should_speak(): self.speak(conn)
                self.tuner.last_connector_ts = time.time()

        base = f"{label} ({confidence:.2f}) spotted on {camera_name}."
        self.display(f"AI: {base}")
        if self.tuner.should_speak(): self.speak(base)

        # vehicle vs object chatter
        if kind == "vehicle":
            intro, follow = vehicle_lines(label)
            self.display(f"AI: {intro}")
            if self.tuner.should_speak(): self.speak(intro)
        else:
            line = witty_for_object(label, self.ds)
            self.display(f"AI: {line}")
            if self.tuner.should_speak(): self.speak(line)

        # deeper convo
        if not self.tuner.under_global_cd():
            self.tuner.mark_any()
            user = self.listen(4)
            if user and user != "...":
                row = self.ds.remember_object(label, user)
                # intent-aware reply
                intent = _match_intent(user)
                bank = OBJECT_REPLY_BANK.get(intent, OBJECT_REPLY_BANK["default"])
                reply = random.choice(bank).format(obj=label)
                # add memory nod
                if row.last_keywords:
                    reply += f" (keywords: {', '.join(row.last_keywords[:2])})"
                self.display(f"AI: {reply}")
                if self.tuner.should_speak(): self.speak(reply)

                # update connector state
                self.tuner.prev_obj = label
                self.tuner.prev_kw = row.last_keywords[:5]
                self.tuner.prev_sent = row.last_sentiment.get("label","NEUTRAL")

                # short follow based on sentiment
                lab = self.tuner.prev_sent
                if lab == "NEGATIVE" and self.tuner.sentiment_sensitivity >= 0.4:
                    self.display("AI: Noted—want me to flag this as a concern?")
                    if self.tuner.should_speak(): self.speak("Noted—want me to flag this as a concern?")
                elif lab == "POSITIVE" and self.tuner.sentiment_sensitivity >= 0.4:
                    self.display("AI: Great—should I bookmark what you liked?")
                    if self.tuner.should_speak(): self.speak("Great—should I bookmark what you liked?")
            else:
                # no user reply—still update connector context lightly
                self.tuner.prev_obj = label
                self.tuner.prev_kw = []
                self.tuner.prev_sent = "NEUTRAL"

        # vehicle logging
        if kind == "vehicle":
            self.ds.log_vehicle(label, camera_name)

        self.tuner.mark_key(key)

    # ---------- person handler ----------
    def on_person(self):
        if self.tuner.muted("person", "person"): return
        key = "person:any"
        if self.tuner.under_key_cd(key) or self.tuner.under_global_cd(): return
        self.tuner.mark_any()

        opener = person_opening(self.tuner)
        self.display(f"AI: {opener}")
        if self.tuner.should_speak(): self.speak(opener)

        user = self.listen(4)
        if user and user != "...":
            # naive name capture (if they answer with "I'm X" or "X")
            m = re.search(r"(?:i[' ]?m|my name is)\s+([a-z][a-z '-]{1,25})", user.lower())
            name = (m.group(1).title() if m else user.strip().split(" ")[0].title())
            if name and name.isalpha() and 2 <= len(name) <= 20:
                self.ds.add_known_person(name)
                greet = f"Nice to meet you, {name}! Anything I should track?"
                self.display(f"AI: {greet}")
                if self.tuner.should_speak(): self.speak(greet)
                # optional second turn
                note = self.listen(4)
                if note and note != "...":
                    row = self.ds.remember_object("note", note, source="person")
                    self.display("AI: Noted. I’ll remember.")
                    if self.tuner.should_speak(): self.speak("Noted. I’ll remember.")
                    # update sentiment context
                    self.tuner.prev_obj = "note"
                    self.tuner.prev_kw = row.last_keywords[:5]
                    self.tuner.prev_sent = row.last_sentiment.get("label","NEUTRAL")
            else:
                # general reply
                lab, _ = quick_sentiment(user)
                if lab == "NEGATIVE" and self.tuner.sentiment_sensitivity >= 0.4:
                    self.display("AI: Understood—want me to set a reminder or track an item?")
                    if self.tuner.should_speak(): self.speak("Understood—want me to set a reminder or track an item?")
                else:
                    self.display("AI: Okay. Anything else I should keep?")
                    if self.tuner.should_speak(): self.speak("Okay. Anything else I should keep?")

        self.tuner.mark_key(key)


# Memory: Offline TF-IDF index over chat + notes
# =============================================================================
@dataclass
class MemoryItem:
    ts: str
    source: str           # "chat" | "object" | "person" | "vehicle" | "note"
    sender: str           # "You" | "AI" | "system" | etc.
    text: str
    meta: Dict[str, Any] = field(default_factory=dict)

class TfidfIndex:
    def __init__(self):
        self.items: List[MemoryItem] = []
        self._idf: Dict[str, float] = {}
        self._vecs: List[Dict[str,float]] = []
        self._dirty = True

    def add(self, item: MemoryItem):
        self.items.append(item)
        self._dirty = True

    def bulk_add(self, items: List[MemoryItem]):
        self.items.extend(items)
        self._dirty = True

    def clear(self):
        self.items = []
        self._idf = {}
        self._vecs = []
        self._dirty = True

    def _build(self):
        docs = [it.text for it in self.items]
        # df
        df: Dict[str,int] = {}
        doc_terms: List[List[str]] = []
        for d in docs:
            toks = [w for w in _tokens(d) if w not in _STOP and len(w) >= 3]
            doc_terms.append(toks)
            for w in set(toks):
                df[w] = df.get(w, 0) + 1
        n = max(1, len(docs))
        self._idf = {w: math.log((n + 1) / (dfw + 1)) + 1.0 for w, dfw in df.items()}

        # tf-idf vectors
        vecs: List[Dict[str,float]] = []
        for toks in doc_terms:
            tf: Dict[str,float] = {}
            for w in toks:
                tf[w] = tf.get(w, 0.0) + 1.0
            # normalize tf
            if tf:
                mx = max(tf.values())
                for w in list(tf.keys()):
                    tf[w] = (tf[w] / mx) * self._idf.get(w, 1.0)
            vecs.append(tf)
        self._vecs = vecs
        self._dirty = False

    def _cos(self, a: Dict[str,float], b: Dict[str,float]) -> float:
        if not a or not b:
            return 0.0
        # dot
        dot = 0.0
        for w, av in a.items():
            bv = b.get(w)
            if bv:
                dot += av * bv
        na = math.sqrt(sum(v*v for v in a.values()))
        nb = math.sqrt(sum(v*v for v in b.values()))
        if na <= 1e-9 or nb <= 1e-9:
            return 0.0
        return dot / (na * nb)

    def search(self, query: str, top_k: int = 5) -> List[Tuple[float, MemoryItem]]:
        if self._dirty:
            self._build()
        q_toks = [w for w in _tokens(query) if w not in _STOP and len(w) >= 3]
        q_tf: Dict[str,float] = {}
        for w in q_toks:
            q_tf[w] = q_tf.get(w, 0.0) + 1.0
        if q_tf:
            mx = max(q_tf.values())
            for w in list(q_tf.keys()):
                q_tf[w] = (q_tf[w] / mx) * self._idf.get(w, 1.0)

        scored: List[Tuple[float,int]] = []
        for i, v in enumerate(self._vecs):
            s = self._cos(q_tf, v)
            if s > 0.001:
                scored.append((s, i))
        scored.sort(key=lambda x: -x[0])
        out = []
        for s, i in scored[:top_k]:
            out.append((s, self.items[i]))
        return out

class MemoryStore:
    """
    Holds:
      - imported host chat history
      - object notes / person notes / vehicle notes
    """
    def __init__(self):
        self.index = TfidfIndex()
        self._last_import_hash = None

        raw = _load_json(MEMORY_FILE, {"version":1, "items":[]})
        items = []
        for it in raw.get("items", []):
            try:
                items.append(MemoryItem(**it))
            except Exception:
                pass
        if items:
            self.index.bulk_add(items)

    def save(self):
        payload = {
            "version": 1,
            "items": [asdict(it) for it in self.index.items[-5000:]]  # cap size
        }
        _save_json(MEMORY_FILE, payload)

    def add(self, source: str, sender: str, text: str, meta: Optional[Dict[str,Any]] = None):
        it = MemoryItem(ts=_now_iso(), source=source, sender=sender, text=text or "", meta=meta or {})
        self.index.add(it)
        self.save()

    def import_host_chat_history(self, conversation_history: List[Dict[str,Any]]):
        """
        conversation_history like:
          [{"time": <unix_ts>, "sender": "You|AI", "text": "..."}]
        """
        if not conversation_history:
            return
        # avoid re-importing identical history by a cheap signature
        try:
            sig = (len(conversation_history),
                   conversation_history[-1].get("time"),
                   conversation_history[-1].get("sender"),
                   (conversation_history[-1].get("text") or "")[:50])
        except Exception:
            sig = None
        if sig == self._last_import_hash:
            return
        self._last_import_hash = sig

        # Import recent chunk (avoid duplication explosion)
        existing_tail = { (it.source, it.sender, it.text, it.ts) for it in self.index.items[-500:] }
        added = 0
        items = []
        for row in conversation_history[-400:]:
            try:
                ts = row.get("time")
                ts_iso = datetime.utcfromtimestamp(float(ts)).isoformat(timespec="seconds") + "Z" if ts else _now_iso()
                sender = row.get("sender","")
                text = row.get("text","")
                key = ("chat", sender, text, ts_iso)
                if key in existing_tail:
                    continue
                items.append(MemoryItem(ts=ts_iso, source="chat", sender=sender, text=text, meta={}))
                added += 1
            except Exception:
                continue
        if items:
            self.index.bulk_add(items)
            self.save()

    def search(self, query: str, top_k: int = 5) -> List[Tuple[float, MemoryItem]]:
        return self.index.search(query, top_k=top_k)

# =============================================================================
# Tuner (lots of knobs)
# =============================================================================
@dataclass
class TunerPro:
    # --- core output toggles ---
    voice_enabled: bool = True
    narrate_persons: bool = True
    narrate_objects: bool = True
    narrate_vehicles: bool = True

    # --- behavior controls ---
    style: str = "playful"                 # playful | neutral | serious
    verbosity: int = 1                     # 0 terse, 1 normal, 2 chatty
    temperature: float = 0.7               # randomness for template selection

    use_connectors: bool = True
    connector_min_secs: float = 2.0

    ask_followups: bool = True
    followup_rate: float = 0.55            # probability after an event to ask/engage
    listen_seconds: int = 4

    intent_replies: bool = True            # use intent templates
    sentiment_sensitivity: float = 0.5     # 0..1 how much to react to pos/neg

    # --- memory nods ---
    use_memory: bool = True
    memory_strength: float = 0.5           # 0..1; how often we mention history
    memory_top_k: int = 3

    # --- cooldowns/mutes ---
    global_cooldown: float = 3.0
    per_key_cooldown: float = 10.0
    muted_labels: set = field(default_factory=set)  # labels to ignore

    # runtime
    _last_any: float = 0.0
    _last_key: Dict[str, float] = field(default_factory=dict)
    prev_obj: Optional[str] = None
    prev_keywords: List[str] = field(default_factory=list)
    prev_sent: str = "NEUTRAL"
    last_connector_ts: float = 0.0
    recent_labels: deque = field(default_factory=lambda: deque(maxlen=10))

    def under_global_cd(self) -> bool:
        return (time.time() - self._last_any) < float(self.global_cooldown)

    def under_key_cd(self, key: str) -> bool:
        return (time.time() - self._last_key.get(key, 0.0)) < float(self.per_key_cooldown)

    def mark_any(self):
        self._last_any = time.time()

    def mark_key(self, key: str):
        self._last_key[key] = time.time()

    def muted(self, label: str, kind: str) -> bool:
        l = (label or "").lower().strip()
        if l in self.muted_labels:
            return True
        if kind == "person" and not self.narrate_persons:
            return True
        if kind == "vehicle" and not self.narrate_vehicles:
            return True
        if kind == "object" and not self.narrate_objects:
            return True
        return False

    def seen_recent(self, label: str) -> bool:
        l = (label or "").lower().strip()
        if l in self.recent_labels:
            return True
        self.recent_labels.append(l)
        return False

def _ensure_default_tuner():
    if not os.path.exists(TUNER_FILE):
        # keep JSON-friendly (convert set to list)
        t = asdict(TunerPro())
        t["muted_labels"] = []
        _save_json(TUNER_FILE, {"version": 1, "tuner": t})

class TunerStore:
    def __init__(self):
        _ensure_default_tuner()
        raw = _load_json(TUNER_FILE, {"version":1, "tuner": {}})
        t = raw.get("tuner", {})
        # rebuild tuner with defaults if missing
        self.tuner = TunerPro(**{k:v for k,v in t.items() if k != "muted_labels"})
        self.tuner.muted_labels = set((t.get("muted_labels") or []))

    def save(self):
        payload = asdict(self.tuner)
        payload["muted_labels"] = sorted(list(self.tuner.muted_labels))
        _save_json(TUNER_FILE, {"version": 1, "tuner": payload})


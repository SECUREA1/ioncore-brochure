            e = object_memory[target][-1]
            return f"{target} last status: {e['status']} on [{e['camera']}] at {now_str(e['time'])}."
        return "I don't have that yet."
    if "list people" in tl or "list persons" in tl:
        names = sorted(k for k in person_memory.keys() if not k.lower().startswith("unknown"))
        return "Known persons: " + (", ".join(names) if names else "none")
    if "list objects" in tl:

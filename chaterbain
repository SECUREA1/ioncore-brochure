# Tokenization / stopwords
# -------------------------
_STOP = set("""
a an and the is it this that those these to for with on in of as by from at into over under up down out be been are was were am will would can could should might maybe very really just your our their his her its not don't can't won't isn't wasn't weren't couldn't shouldn't they've we're i'm you're i've it'll we'll you'll
""".split())

def _tokens(text: str) -> List[str]:
    return re.findall(r"[a-z0-9']+", (text or "").lower())

def extract_keywords(text: str, k: int = 6) -> List[str]:
    toks = _tokens(text)
    scored: Dict[str, float] = {}
    for i, w in enumerate(toks):
        if w in _STOP or len(w) < 3:
            continue
        # weighted by early-position + frequency
        scored[w] = scored.get(w, 0.0) + 1.0 + (2.0 / (1.0 + i))
    return [w for w, _ in sorted(scored.items(), key=lambda x: -x[1])[:k]]

def quick_sentiment(text: str) -> Tuple[str, float]:
    t = (text or "").strip().lower()
    if not t:
        return "NEUTRAL", 0.5
    pos = {"good","great","love","like","nice","cool","awesome","fun","perfect","yes","sweet","wow","amazing","solid"}
    neg = {"bad","hate","dislike","no","annoy","angry","broken","problem","meh","ugly","ugh","awful","worse","worst"}
    words = set(re.findall(r"[a-z']+", t))
    p = len(words & pos)
    n = len(words & neg)
    if p > n:
        return "POSITIVE", min(1.0, 0.55 + 0.1 * p)
    if n > p:
        return "NEGATIVE", min(1.0, 0.55 + 0.1 * n)
    return "NEUTRAL", 0.5

# =============================================================================
# Macro renderer (makes templates powerful but safe)
# =============================================================================
_MACRO = re.compile(r"\{([^{}]+)\}")

def _safe_float(x, default=0.0):
    try:
        return float(x)
    except Exception:
        return default

def _macro_choose(arg: str) -> str:
    parts = [p.strip() for p in arg.split("|") if p.strip()]
    return random.choice(parts) if parts else ""

def _macro_clip(val: str, n: str) -> str:
    try:
        nn = int(n)
    except Exception:
        nn = 80
    s = str(val or "")
    return s[:nn]

def render_template(text: str, ctx: Dict[str, Any]) -> str:
    """
    Supported macros:
      {obj} {camera} {conf} {mood} {kw0} {kw1} ...
      {choose:a|b|c}
      {upper:obj} {lower:obj} {title:obj}
      {clip:var,60}
      {time:%H:%M:%S}
      {randint:1,5}
    """
    def repl(m):
        expr = m.group(1).strip()
        # function macros
        if expr.startswith("choose:"):
            return _macro_choose(expr.split("choose:",1)[1])
        if expr.startswith("upper:"):
            key = expr.split("upper:",1)[1].strip()
            return str(ctx.get(key,"")).upper()
        if expr.startswith("lower:"):
            key = expr.split("lower:",1)[1].strip()
            return str(ctx.get(key,"")).lower()
        if expr.startswith("title:"):
            key = expr.split("title:",1)[1].strip()
            return str(ctx.get(key,"")).title()
        if expr.startswith("clip:"):
            arg = expr.split("clip:",1)[1]
            if "," in arg:
                k, n = [x.strip() for x in arg.split(",",1)]
                return _macro_clip(str(ctx.get(k,"")), n)
            return str(ctx.get(arg.strip(),""))
        if expr.startswith("time:"):
            fmt = expr.split("time:",1)[1].strip() or "%H:%M:%S"
            return time.strftime(fmt, time.localtime())
        if expr.startswith("randint:"):
            arg = expr.split("randint:",1)[1]
            a, b = 0, 10
            try:
                a_s, b_s = [x.strip() for x in arg.split(",",1)]
                a, b = int(a_s), int(b_s)
            except Exception:
                pass
            return str(random.randint(a, b))

        # keywords shortcuts: kw0, kw1
        if expr.startswith("kw") and expr[2:].isdigit():
            i = int(expr[2:])
            kws = ctx.get("keywords") or []
            return str(kws[i]) if i < len(kws) else ""

        # plain var
        return str(ctx.get(expr, ""))

    out = _MACRO.sub(repl, text or "")
    # normalize spaces
    out = re.sub(r"\s+", " ", out).strip()
    return out


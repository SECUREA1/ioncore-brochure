def load_known():
    known_encodings.clear(); known_names.clear()
    if not face_enabled: return
    for person in os.listdir(KNOWN_DIR):
        pdir = os.path.join(KNOWN_DIR, person)
        enc_path = os.path.join(pdir, "encodings.npy")
        if os.path.isdir(pdir) and os.path.exists(enc_path):
            try:
                arr = np.load(enc_path, allow_pickle=True)
                for enc in arr:
                    known_encodings.append(enc)
                    known_names.append(person)
                log.info(f"Loaded encodings for {person}.")
            except Exception as e:
                log.warning(f"Load enc for {person} failed: {e}")

load_known()

def identify_faces(frame_bgr):
    if not face_enabled: return []
    rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
    locs = face_recognition.face_locations(rgb, model=FACE_MODEL)
    encs = face_recognition.face_encodings(rgb, locs)
    results = []
    for (top,right,bottom,left), enc in zip(locs, encs):
        name = "Unknown"
        if len(known_encodings) > 0:
            matches = face_recognition.compare_faces(known_encodings, enc, tolerance=0.6)
            dists = face_recognition.face_distance(known_encodings, enc)
            best = int(np.argmin(dists)) if len(dists)>0 else -1
            if best >= 0 and matches[best]:
                name = known_names[best]
        results.append(((left, top, right-left, bottom-top), name, enc))
    return results


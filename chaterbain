        return list(self.rules)

    def set_rules(self, rules: List[Dict[str, Any]]):
        self.rules = rules
        self.save()

    def match(self, text: str) -> Optional[Tuple[Dict[str,Any], re.Match]]:
        t = (text or "").strip()
        scored = []
        for r in self.rules:
            try:
                m = re.match(r.get("pattern",""), t, flags=re.IGNORECASE)
                if m:
                    scored.append((int(r.get("priority", 0)), r, m))
            except Exception:
                continue
        if not scored:
            return None
        scored.sort(key=lambda x: -x[0])
        _, rule, m = scored[0]
        return rule, m


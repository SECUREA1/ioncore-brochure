def _pick_bank(mood: str, style: str):
    style = (style or "playful").lower()
    if style == "serious": return _CONNECTOR_SERIOUS
    if style == "neutral": return _CONNECTOR_NEUTRAL
    # playful default; tilt by mood a little
    return _CONNECTOR_NEUTRAL if mood == "NEGATIVE" else _CONNECTOR_PLAYFUL

def tie_connector(previous_obj: str,
                  current_obj: str,
                  prev_keywords: Optional[List[str]] = None,
                  mood: str = "NEUTRAL",
                  style: str = "playful",
                  max_len: int = 80,
                  nod_keywords: bool = True) -> str:
    if not previous_obj: return ""
    bank = _pick_bank(mood, style)
    base = random.choice(bank).format(prev=previous_obj.capitalize(), cur=current_obj)
    if nod_keywords and prev_keywords:
        kw = random.choice((prev_keywords or [])[:3])
        tail = random.choice([
            f"—echoing '{kw}'.",
            f"—still about '{kw}'.",
            f"—riffing on '{kw}'.",
        ])
        if len(base) + len(tail) <= max_len:
            base += tail
    return base


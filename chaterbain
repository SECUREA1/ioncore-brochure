    root.after(1500, refresh_lists)

def render_loop():
    for idx, (worker, name, img_lbl) in list(camera_windows.items()):
        frame = worker.get() if worker else None
        if frame is None: continue
        try:
            if FRAME_SKIP > 0:
                # Skip processing every N frames (simple throttle)
                pass
            processed = process_frame(frame, name) if (yolo_enabled or face_enabled) else frame
            disp = cv2.resize(processed, (DISPLAY_W, DISPLAY_H), interpolation=cv2.INTER_AREA)
            rgb = cv2.cvtColor(disp, cv2.COLOR_BGR2RGB)
            pil = Image.fromarray(rgb)
            imgtk = ImageTk.PhotoImage(pil)
            img_lbl.configure(image=imgtk)
            img_lbl.image = imgtk
        except Exception as e:
            log.debug(f"Render error cam{idx}: {e}")
    root.after(FRAME_LOOP_DELAY_MS, render_loop)


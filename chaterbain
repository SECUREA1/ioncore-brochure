    global tuner_overlay
    if tuner_overlay is not None:
        try:
            tuner_overlay.place_forget()
            tuner_overlay.destroy()
        except Exception:
            pass
        tuner_overlay = None
    tuner_overlay_state["visible"] = False
    TUNER_SWITCH_VAR.set(0)


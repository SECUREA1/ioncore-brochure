def quick_sentiment(text: str) -> Tuple[str,float]:
    t = (text or "").strip()
    if not t: return "NEUTRAL", 0.5
    if TRANSFORMERS_AVAILABLE:
        try:
            r = _sent(t[:512])[0]
            lab = r["label"].upper(); score = float(r["score"])
            if lab not in ("POSITIVE","NEGATIVE"): lab,score="NEUTRAL",0.5
            return lab, score
        except Exception:
            pass
    pos = {"good","great","love","like","nice","cool","awesome","fun","perfect","yes"}
    neg = {"bad","hate","dislike","no","annoy","angry","broken","problem","meh","ugly"}
    words = set(re.findall(r"[a-z']+", t.lower()))
    p = len(words & pos); n = len(words & neg)
    if p>n: return "POSITIVE", min(1.0, 0.55+0.1*p)
    if n>p: return "NEGATIVE", min(1.0, 0.55+0.1*n)
    return "NEUTRAL", 0.5


def boxes_overlap(boxA, boxB) -> bool:
    xA, yA, wA, hA = boxA
    xB, yB, wB, hB = boxB
    inter_x1 = max(xA, xB)
    inter_y1 = max(yA, yB)
    inter_x2 = min(xA + wA, xB + wB)
    inter_y2 = min(yA + hA, yB + hB)
    return (inter_x2 > inter_x1) and (inter_y2 > inter_y1)


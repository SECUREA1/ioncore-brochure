def extract_keywords(text: str, k: int = 6) -> List[str]:
    tokens = re.findall(r"[a-z0-9']+", (text or "").lower())
    scored: Dict[str,int] = {}
    for i, w in enumerate(tokens):
        if w in _STOP or len(w) < 3: continue
        scored[w] = scored.get(w, 0) + 3 + int(10/(1+i))
    return [w for w,_ in sorted(scored.items(), key=lambda x: -x[1])[:k]]

def quick_sentiment(text: str) -> Tuple[str,float]:
    """Heuristic sentiment (POSITIVE/NEGATIVE/NEUTRAL, score 0..1)."""
    t = (text or "").strip().lower()
    if not t: return "NEUTRAL", 0.5
    pos = {"good","great","love","like","nice","cool","awesome","fun","perfect","yes","sweet","wow"}
    neg = {"bad","hate","dislike","no","annoy","angry","broken","problem","meh","ugly","ugh"}
    words = set(re.findall(r"[a-z']+", t))
    p = len(words & pos); n = len(words & neg)
    if p > n:  return "POSITIVE", min(1.0, 0.55 + 0.1*p)
    if n > p:  return "NEGATIVE", min(1.0, 0.55 + 0.1*n)
    return "NEUTRAL", 0.5


def _dequeue_all_for_uid(target_uid):
    kept, picked = [], []
    for item in unknown_faces_queue:
        enc, img, uid, cam, kind = item
        if uid == target_uid:
            picked.append(item)
        else:
            kept.append(item)
    unknown_faces_queue[:] = kept
    return picked


        self._display(f"System: Tuner Voice={self.tuner.voice_enabled} Persons={self.tuner.narrate_persons} Objects={self.tuner.narrate_objects} Vehicles={self.tuner.narrate_vehicles}")

    def _mute_label(self):
        l = (self.mute_label_var.get() or "").strip().lower()
        if l:
            self.tuner.muted_labels.add(l)
            self._display(f"System: muted '{l}'")

    def _unmute_label(self):
        l = (self.mute_label_var.get() or "").strip().lower()
        if l in self.tuner.muted_labels:
            self.tuner.muted_labels.remove(l); self._display(f"System: unmuted '{l}'")
        else:
            self._display(f"System: '{l}' was not muted")

    def _reset_all_cams(self):
        for w in self.workers:
            w.stop()
        self.workers = [CameraWorker(src) for src in CAM_SOURCES]
        for w in self.workers: w.start()
        self._display("System: cameras reset.")

    def _on_user_ask(self):
        text = self.input_var.get().strip()
        if not text: return
        self._display(f"You: {text}")
        ans = chat_response(text, self._context_summary())
        self._say(ans)
        self.input_var.set("")

    # ---------- video render loop (flex-fit) ----------
    def _draw_last_frame(self):
        if self._last_frame_rgb is None: return
        rgb = self._last_frame_rgb
        ch = self.video_canvas.winfo_height() or 1
        cw = self.video_canvas.winfo_width() or 1
        ih, iw = rgb.shape[:2]
        scale = min(cw/iw, ch/ih)
        nw, nh = max(1, int(iw*scale)), max(1, int(ih*scale))
        img = Image.fromarray(rgb).resize((nw, nh))
        imgtk = ImageTk.PhotoImage(image=img)
        self.video_canvas.delete("all")
        self.video_canvas.create_image((cw-nw)//2, (ch-nh)//2, anchor=tk.NW, image=imgtk)
        self.video_canvas.imgtk = imgtk

    def _video_loop(self):
        # loop feed: fetch latest frame from current worker and render
        try:
            cur = self.workers[self.cur_idx]
            frame = cur.get_frame()
            if frame is not None:
                # run detection at cadence on the shown feed only
                now = time.time()
                if (now - self._last_detect) * 1000 >= self._detect_every_ms:
                    self._last_detect = now
                    self._detect_and_react(frame)
                # draw
                rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                self._last_frame_rgb = rgb
                self._draw_last_frame()
        except Exception:
            pass
        # schedule next tick
        self.root.after(16, self._video_loop)  # ~60 FPS draw loop

    # ---------- carousel loop (switch cameras) ----------
    def _carousel_loop(self):
        # loop feed: switch which camera is shown every CAROUSEL_SECS
        if len(self.workers) > 1:
            if (time.time() - self._last_switch) >= CAROUSEL_SECS:
                self._last_switch = time.time()
                self.cur_idx = (self.cur_idx + 1) % len(self.workers)
                self._display(f"System: switched to camera {self.cur_idx+1}/{len(self.workers)}")
        self.root.after(500, self._carousel_loop)

    # ---------- detection loop (on current feed) ----------
    def _detect_and_react(self, frame_bgr):
        h, w, _ = frame_bgr.shape
        blob = cv2.dnn.blobFromImage(frame_bgr, 0.00392, (416,416), swapRB=True, crop=False)
        yolo.setInput(blob)
        outs = yolo.forward(output_layers)

        boxes, class_ids, confidences = [], [], []
        for out in outs:
            for det in out:
                scores = det[5:]
                cid = int(np.argmax(scores))
                conf = float(scores[cid])
                if conf > 0.5:
                    cx = int(det[0] * w); cy = int(det[1] * h)
                    bw = int(det[2] * w); bh = int(det[3] * h)
                    x = int(cx - bw/2); y = int(cy - bh/2)
                    boxes.append([x,y,bw,bh]); class_ids.append(cid); confidences.append(conf)

        labels = []
        for i, b in enumerate(boxes):
            x,y,bw,bh = b
            label = str(classes[class_ids[i]]); conf = confidences[i]
            labels.append(label)
            # draw onto frame for display
            cv2.rectangle(frame_bgr, (x,y), (x+bw,y+bh), (0,255,0), 2)
            cv2.putText(frame_bgr, label, (x, max(15,y-8)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,0), 2)

            # conversation loops (object/person)
            if label.lower() == "person":
                # person loop
                if not self.tuner.under_key_cd("person:any") and not self.tuner.muted("person","person"):
                    self.tuner.mark_key("person:any"); Thread(target=self._person_loop, daemon=True).start()
            else:
                # object/vehicle loop
                kind = "vehicle" if label.lower() in VEHICLE_LABELS else "object"
                key = f"{kind}:{label.lower()}"
                if not self.tuner.under_key_cd(key) and not self.tuner.seen_recent(label) and not self.tuner.muted(label, kind):
                    self.tuner.mark_key(key)
                    Thread(target=self._object_loop, args=(label, conf), daemon=True).start()

        self._last_boxes, self._last_labels, self._last_confs = boxes, labels, confidences

    # ---------- object conversation loop ----------
    def _object_loop(self, label: str, conf: float):
        # connector + base
        conn = connector(self.tuner.prev_obj, label, self.tuner.prev_kw, self.tuner.prev_sent) if self.tuner.prev_obj else ""
        base = f"{label} ({conf:.2f}) spotted."
        line = (conn + " " + base).strip() if conn else base
        self._display(f"AI: {line}"); speak(line, self.tuner.should_speak())

        # deeper convo if not under global cooldown
        if not self.tuner.under_global_cd():
            self.tuner.mark_any()
            flavor = witty_for_object(label)
            self._display(f"AI: {flavor}"); speak(flavor, self.tuner.should_speak())
            user = listen(4)
            if user and user != "...":
                remember_object(label, user)
                reply = chat_response(user, self._context_summary())
                self._say(reply)
                s_lab, _ = quick_sentiment(user)
                self.tuner.prev_obj = label
                self.tuner.prev_kw = extract_keywords(user, 5)
                self.tuner.prev_sent = s_lab
                follow = adaptive_followup(s_lab)
                self._display(f"AI: {follow}"); speak(follow, self.tuner.should_speak())
            else:
                self.tuner.prev_obj = label
                self.tuner.prev_kw = []
                self.tuner.prev_sent = "NEUTRAL"

    # ---------- person conversation loop ----------
    def _person_loop(self):
        if self.tuner.under_global_cd(): return
        self.tuner.mark_any()
        ask_name = (len(people_memory.get("names", [])) == 0) or (random.random() < 0.25)
        if ask_name:
            q = "Hello! I don't think we've met. What's your name?"
            self._display(f"AI: {q}"); speak(q, self.tuner.should_speak())
            name = listen(4).strip()
            if name and name not in ["...","unknown","Unknown"]:
                arr = people_memory.get("names", [])
                if name not in arr: arr.append(name); people_memory["names"] = arr; _save_json(PERSON_MEMORY_FILE, people_memory)
                greet = f"Nice to meet you, {name}! Anything I should note for you?"
                self._display(f"AI: {greet}"); speak(greet, self.tuner.should_speak())
            else:
                greet = "Hi there! How’s your day going?"
                self._display(f"AI: {greet}"); speak(greet, self.tuner.should_speak())
        else:
            opener = random.choice(["How’s your day going?","Working on something today?","Need me to track an item for you?"])
            self._display(f"AI: {opener}"); speak(opener, self.tuner.should_speak())

        user = listen(4)
        if user and user != "...":
            ans = chat_response(user, self._context_summary())
            self._say(ans)

    # ---------- context + summary loop ----------
    def _context_summary(self) -> str:
        if not self._last_labels: return "No notable objects in view."
        counts = {}
        for l in self._last_labels: counts[l] = counts.get(l,0)+1
        parts = [f"{k} x{v}" for k,v in counts.items()]
        mems = []
        for k, v in list(object_stories.items())[-4:]:
            if isinstance(v, dict):
                mems.append(f"{k}: '{(v.get('last_transcript') or '')[:40]}'")
        s = "In view: " + ", ".join(parts)
        if mems: s += ". Recent notes: " + "; ".join(mems)
        return s

    def _session_summary(self):
        pos=neg=0
        for row in object_stories.values():
            if isinstance(row, dict):
                lab = (row.get("last_sentiment", {}) or {}).get("label","NEUTRAL")
                if lab=="POSITIVE": pos+=1
                elif lab=="NEGATIVE": neg+=1
        vibe = 'positive' if pos>neg else ('negative' if neg>pos else 'balanced')
        lines = [f"Summary — entries: {sum((v.get('count',1) if isinstance(v,dict) else 1) for v in object_stories.values())}, vibe: {vibe}"]
        items=[]
        for k,v in object_stories.items():
            last = v.get("last_seen") if isinstance(v,dict) else ""
            items.append((last,k,v))
        items.sort(key=lambda t: t[0], reverse=True)
        for _,name,row in items[:6]:
            if isinstance(row, dict):
                lab = (row.get("last_sentiment", {}) or {}).get("label","NEUTRAL")
                kw = ", ".join((row.get("last_keywords") or [])[:4])
                last_txt = (row.get("last_transcript") or "")[:80]
                lines.append(f"- {name}: {lab}; [{kw}] — “{last_txt}”")
        wrap = online_chat_response("Summarize warmly in 2 sentences:\n"+"\n".join(lines[-min(7,len(lines)):]),
                                    system="You write warm, concise wrap-ups.")
        if wrap: lines.append(wrap)
        for ln in lines: self._display(f"AI: {ln}")
        if wrap: Thread(target=speak, args=(wrap, self.tuner.should_speak()), daemon=True).start()


# Intent classifier (editable-ish; you can expand this too)
# =============================================================================
_OBJECT_INTENTS = [
    ("track",  {"track","watch","monitor","keep an eye","alert","notify","follow"}),
    ("move",   {"move","relocate","shift","bring","place","put"}),
    ("fix",    {"fix","repair","broken","issue","maintenance","problem","fault"}),
    ("where",  {"where","location","position","lost","missing","see","present"}),
    ("like",   {"like","love","great","nice","cool","awesome"}),
    ("dislike",{"hate","dislike","bad","annoy","ugly","meh"})
]

def match_intent(text: str) -> str:
    t = (text or "").lower()
    for name, keys in _OBJECT_INTENTS:
        if any(k in t for k in keys):
            return name
    return "default"

# =============================================================================
# Brain PRO
# =============================================================================
VEHICLE_LABELS = {"car","truck","bus","bicycle","motorbike","motorcycle","train","boat","aeroplane","airplane"}

class BrainPro:
    """
    Public API:
      - on_object(label, conf, camera)
      - on_person(camera)
      - handle_user_message(text)  # commands & history search
      - import_host_history(conversation_history)
      - export_state()/import_state() for full portability
    """
    def __init__(self,
                 display_fn: Callable[[str], None],
                 speak_fn: Callable[[str], None],
                 listen_fn: Callable[[int], str],
                 templates: Optional[TemplateStore] = None,
                 rules: Optional[RuleStore] = None,
                 tuner_store: Optional[TunerStore] = None,
                 memory: Optional[MemoryStore] = None):
        self.display = display_fn
        self.speak = speak_fn
        self.listen = listen_fn

        self.templates = templates or TemplateStore()
        self.rules = rules or RuleStore()
        self.tuner_store = tuner_store or TunerStore()
        self.tuner = self.tuner_store.tuner
        self.memory = memory or MemoryStore()

        self.scene_labels: List[str] = []
        self.scene_counts: Dict[str,int] = {}

    # --------------- persistence helpers ---------------
    def save_all(self):
        self.templates.save()
        self.rules.save()
        self.tuner_store.save()
        self.memory.save()

    def export_state(self) -> Dict[str, Any]:
        return {
            "templates": self.templates.data,
            "rules": self.rules.data,
            "tuner": _load_json(TUNER_FILE, {}),
            "memory": _load_json(MEMORY_FILE, {}),
        }

    def import_state(self, payload: Dict[str, Any]):
        # templates
        try:
            t = payload.get("templates")
            if isinstance(t, dict) and t.get("templates"):
                self.templates.data = t
                self.templates.templates = t.get("templates", {})
                self.templates.save()
        except Exception:
            pass
        # rules
        try:
            r = payload.get("rules")
            if isinstance(r, dict) and r.get("rules"):
                self.rules.data = r
                self.rules.rules = r.get("rules", [])
                self.rules.save()
        except Exception:
            pass
        # tuner
        try:
            tr = payload.get("tuner")
            if isinstance(tr, dict):
                _save_json(TUNER_FILE, tr)
                self.tuner_store = TunerStore()
                self.tuner = self.tuner_store.tuner
        except Exception:
            pass
        # memory
        try:
            m = payload.get("memory")
            if isinstance(m, dict):
                _save_json(MEMORY_FILE, m)
                self.memory = MemoryStore()
        except Exception:
            pass

    # --------------- host integration ---------------
    def import_host_history(self, conversation_history: List[Dict[str,Any]]):
        self.memory.import_host_chat_history(conversation_history)

    def update_scene(self, labels: List[str]):
        self.scene_labels = labels or []
        counts: Dict[str,int] = {}
        for l in self.scene_labels:
            counts[l] = counts.get(l, 0) + 1
        self.scene_counts = counts

    def context_summary(self) -> str:
        if not self.scene_labels:
            return "No notable objects in view."
        parts = [f"{k} x{v}" for k,v in sorted(self.scene_counts.items(), key=lambda x: -x[1])]
        return "In view: " + ", ".join(parts)

    # --------------- internal speak/display ---------------
    def _say(self, text: str):
        if not text:
            return
        self.display(text)
        if self.tuner.voice_enabled:
            self.speak(text)

    def _connector(self, cur_obj: str) -> str:
        if not self.tuner.use_connectors:
            return ""
        if not self.tuner.prev_obj:
            return ""
        if (time.time() - self.tuner.last_connector_ts) < float(self.tuner.connector_min_secs):
            return ""
        style = self.tuner.style
        tid = "connector.playful" if style == "playful" else ("connector.serious" if style == "serious" else "connector.neutral")
        ctx = {
            "prev_obj": self.tuner.prev_obj,
            "cur_obj": cur_obj,
            "keywords": self.tuner.prev_keywords,
            "mood": self.tuner.prev_sent
        }
        line = self.templates.pick(tid, style=style, ctx=ctx, temperature=self.tuner.temperature)
        self.tuner.last_connector_ts = time.time()
        return line

    def _maybe_memory_nod(self, obj: str) -> Optional[str]:
        if not self.tuner.use_memory:
            return None
        if random.random() > max(0.0, min(1.0, float(self.tuner.memory_strength))):
            return None
        hits = self.memory.search(obj, top_k=max(1, int(self.tuner.memory_top_k)))
        if not hits:
            return None
        best = hits[0][1]
        # short, safe nod
        snippet = (best.text or "").strip()
        snippet = snippet[:90] + ("…" if len(snippet) > 90 else "")
        return f"(memory) {best.sender}: {snippet}"

    # --------------- command handling ---------------
    def handle_user_message(self, text: str) -> Optional[str]:
        m = self.rules.match(text)
        if not m:
            return None
        rule, match = m
        act = rule.get("action")

        if act == "help":
            return ("Commands: style playful|neutral|serious; verbosity 0|1|2; "
                    "mute <label>; unmute <label>; followups 0..1; memory 0..1; "
                    "search chat <query>")

        if act == "set_style":
            style = (match.group(1) or "").lower().strip()
            if style in ("playful","neutral","serious"):
                self.tuner.style = style
                self.tuner_store.save()
                return f"Style set to {style}."
            return "Invalid style."

        if act == "set_verbosity":
            v = int(match.group(1))
            self.tuner.verbosity = max(0, min(2, v))
            self.tuner_store.save()
            return f"Verbosity set to {self.tuner.verbosity}."

        if act == "mute_label":
            label = (match.group(1) or "").strip().lower()
            if label:
                self.tuner.muted_labels.add(label)
                self.tuner_store.save()
                return f"Muted label: {label}"
            return "Mute what label?"

        if act == "unmute_label":
            label = (match.group(1) or "").strip().lower()
            if label and label in self.tuner.muted_labels:
                self.tuner.muted_labels.remove(label)
                self.tuner_store.save()
                return f"Unmuted label: {label}"
            return "That label wasn't muted."

        if act == "set_followup_rate":
            r = max(0.0, min(1.0, _safe_float(match.group(1), 0.55)))
            self.tuner.followup_rate = r
            self.tuner_store.save()
            return f"Follow-up rate set to {r:.2f}."

        if act == "set_memory_strength":
            r = max(0.0, min(1.0, _safe_float(match.group(1), 0.50)))
            self.tuner.memory_strength = r
            self.tuner_store.save()
            return f"Memory strength set to {r:.2f}."

        if act == "search_chat":
            q = (match.group(1) or "").strip()
            hits = self.memory.search(q, top_k=5)
            if not hits:
                return "No matches in chat memory."
            lines = []
            for score, it in hits:
                snip = (it.text or "").strip()
                snip = snip[:110] + ("…" if len(snip) > 110 else "")
                lines.append(f"- {it.sender}: {snip}")
            return "Top chat matches:\n" + "\n".join(lines)

        return None

    # --------------- main event handlers ---------------
    def on_object(self, label: str, confidence: float, camera: str = "camera"):
        label = (label or "").strip()
        if not label:
            return
        kind = "vehicle" if label.lower() in VEHICLE_LABELS else "object"
        if self.tuner.muted(label, kind):
            return

        key = f"{kind}:{label.lower()}"
        if self.tuner.under_key_cd(key) or self.tuner.seen_recent(label):
            return

        # Connector
        conn = self._connector(label)
        if conn:
            self._say(conn)

        # Core line
        ctx = {
            "obj": label,
            "camera": camera,
            "conf": f"{float(confidence):.2f}",
            "mood": self.tuner.prev_sent,
            "keywords": self.tuner.prev_keywords
        }
        base = self.templates.pick("core.object_seen", self.tuner.style, ctx, self.tuner.temperature)
        if base:
            self._say(base)

        # Memory nod (optional)
        nod = self._maybe_memory_nod(label)
        if nod and self.tuner.verbosity >= 1:
            self._say(nod)

        # Vehicle chatter vs object witty
        if kind == "vehicle":
            intro = self.templates.pick("vehicle.intro.default", self.tuner.style, ctx, self.tuner.temperature)
            if intro:
                self._say(intro)
            follow = self.templates.pick("vehicle.follow.default", self.tuner.style, ctx, self.tuner.temperature)
            if follow and self.tuner.verbosity >= 1 and random.random() < 0.65:
                self._say(follow)
            # remember vehicle event in memory store
            self.memory.add(source="vehicle", sender="AI", text=f"{label} seen on {camera} (conf {confidence:.2f})", meta={"camera": camera})
        else:
            # specialized object witty if exists
            special_id = f"object.witty.{label.lower()}"
            tid = special_id if special_id in self.templates.templates else "object.witty.default"
            witty = self.templates.pick(tid, self.tuner.style, ctx, self.tuner.temperature)
            if witty:
                self._say(witty)

        # Follow-up conversation (listen + intent reply)
        if self.tuner.ask_followups and (not self.tuner.under_global_cd()) and (random.random() < float(self.tuner.followup_rate)):
            self.tuner.mark_any()
            user = ""
            try:
                user = (self.listen(int(self.tuner.listen_seconds)) or "").strip()
            except Exception:
                user = ""
            if user:
                # store user chat into memory
                self.memory.add(source="chat", sender="You", text=user, meta={"camera": camera, "obj": label})
                intent = match_intent(user)
                rep_id = f"intent.reply.{intent}"
                if rep_id not in self.templates.templates:
                    rep_id = "intent.reply.default"
                reply = self.templates.pick(rep_id, self.tuner.style, ctx={**ctx, "obj": label, "keywords": extract_keywords(user, 6)}, temperature=self.tuner.temperature)
                if reply:
                    # add a keyword nod if verbosity allows
                    kws = extract_keywords(user, 6)
                    if kws and self.tuner.verbosity >= 2:
                        reply += f" (keywords: {', '.join(kws[:2])})"
                    self._say(reply)

                lab, _ = quick_sentiment(user)
                self.tuner.prev_sent = lab
                self.tuner.prev_keywords = extract_keywords(user, 6)
            else:
                self.tuner.prev_sent = "NEUTRAL"
                self.tuner.prev_keywords = []

        # update connector state
        self.tuner.prev_obj = label
        self.tuner.mark_key(key)
        self.tuner_store.save()

    def on_person(self, camera: str = "camera"):
        if self.tuner.muted("person", "person"):
            return
        key = "person:any"
        if self.tuner.under_key_cd(key) or self.tuner.under_global_cd():
            return
        self.tuner.mark_any()

        # Core person line
        base = self.templates.pick("core.person_seen", self.tuner.style, {"camera": camera}, self.tuner.temperature)
        if base and self.tuner.verbosity >= 1:
            self._say(base)

        # Pick opener based on previous sentiment
        mood = self.tuner.prev_sent
        if mood == "POSITIVE" and self.tuner.sentiment_sensitivity >= 0.3:
            opener_id = "person.opener.positive"
        elif mood == "NEGATIVE" and self.tuner.sentiment_sensitivity >= 0.3:
            opener_id = "person.opener.negative"
        else:
            opener_id = "person.opener.neutral"

        opener = self.templates.pick(opener_id, self.tuner.style, {"camera": camera}, self.tuner.temperature)
        if opener:
            self._say(opener)

        # Listen briefly
        user = ""
        try:
            user = (self.listen(int(self.tuner.listen_seconds)) or "").strip()
        except Exception:
            user = ""

        if user:
            self.memory.add(source="chat", sender="You", text=user, meta={"camera": camera, "kind": "person"})
            # naive name capture
            m = re.search(r"(?:i[' ]?m|my name is)\s+([a-z][a-z '-]{1,25})", user.lower())
            name = (m.group(1).title() if m else "")
            if name:
                self.memory.add(source="person", sender="AI", text=f"Met/identified: {name}", meta={"camera": camera})
                self._say(f"Nice to meet you, {name}! Anything I should track?")
            else:
                ack = self.templates.pick("meta.ack", self.tuner.style, {}, self.tuner.temperature) or "Okay."
                self._say(ack)

            lab, _ = quick_sentiment(user)
            self.tuner.prev_sent = lab
            self.tuner.prev_keywords = extract_keywords(user, 6)

        self.tuner.mark_key(key)
        self.tuner_store.save()

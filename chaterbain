def _open_mute_editor(kind):
    win = tk.Toplevel(root); win.title(f"Mute {kind.capitalize()}")
    win.geometry("420x380+120+120")
    items = mute_rules[kind]
    lb = tk.Listbox(win); lb.pack(fill="both", expand=True, padx=8, pady=(8,4))
    for it in sorted(set(items)): lb.insert(tk.END, it)
    entry = tk.Entry(win); entry.pack(fill="x", padx=8, pady=4)
    btns = tk.Frame(win); btns.pack(fill="x", padx=8, pady=8)
    def add_item():
        v = entry.get().strip()
        if v:
            items.append(v)
            save_mute_rules()
            lb.insert(tk.END, v); entry.delete(0, tk.END)
    def rm_item():
        sel = lb.curselection()
        if not sel: return
        val = lb.get(sel[0])
        try:
            items.remove(val)
        except ValueError:
            pass
        save_mute_rules()
        lb.delete(sel[0])
    tk.Button(btns, text=f"Add {kind[:-1].capitalize()}", command=add_item).pack(side=tk.LEFT, padx=4)
    tk.Button(btns, text="Remove Selected", command=rm_item).pack(side=tk.LEFT, padx=4)


def _open_capture(idx, w, h, fps_ms):
    prefs = []
    for a in ("CAP_MSMF","CAP_DSHOW","CAP_V4L2","CAP_AVFOUNDATION","CAP_ANY"):
        if hasattr(cv2, a): prefs.append(getattr(cv2, a))
    target_fps = max(15, min(60, int(1000/max(1, fps_ms))))
    for api in prefs:
        try:
            cap = cv2.VideoCapture(idx, api)
        except Exception:
            cap = cv2.VideoCapture(idx)
        if not cap or not cap.isOpened():
            if cap: cap.release()
            continue
        try: cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        except Exception: pass
        try: cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
        except Exception: pass
        try: cap.set(cv2.CAP_PROP_FRAME_WIDTH, int(w))
        except Exception: pass
        try: cap.set(cv2.CAP_PROP_FRAME_HEIGHT, int(h))
        except Exception: pass
        try: cap.set(cv2.CAP_PROP_FPS, target_fps)
        except Exception: pass
        if cap.isOpened(): return cap
        cap.release()
    return None

class CameraWorker(threading.Thread):
    def __init__(self, idx, name, w, h, fps_ms):
        super().__init__(daemon=True)
        self.idx = idx
        self.name = name
        self.w = w; self.h = h
        self.fps_ms = fps_ms
        self.cap = None
        self.lock = threading.Lock()
        self.latest = None
        self.running = threading.Event()

    def run(self):
        self.running.set()
        fail = 0
        while self.running.is_set():
            if self.cap is None or not self.cap.isOpened():
                self.cap = _open_capture(self.idx, self.w, self.h, self.fps_ms)
                if not self.cap:
                    time.sleep(1.0); continue
            ok, frame = self.cap.read()
            if ok and frame is not None:
                with self.lock:
                    self.latest = frame
                time.sleep(max(0.001, self.fps_ms/1000.0))
                fail = 0
            else:
                fail += 1
                if fail >= 5:
                    try: self.cap.release()
                    except Exception: pass
                    self.cap = None
                    fail = 0
                time.sleep(0.1)
        if self.cap is not None:
            try: self.cap.release()
            except Exception: pass

    def stop(self):
        self.running.clear()

    def get(self):
        with self.lock:
            if self.latest is None: return None
            return self.latest.copy()


def _active_cam_count():
    return len([1 for (w, _, _) in camera_windows.values() if w and w.is_alive()])

def _canvas_avail_wh():
    vw = int(video_canvas.winfo_width() or video_feed_frame.winfo_width() or root.winfo_width() or 800)
    vh = int(video_canvas.winfo_height() or video_feed_frame.winfo_height() or 300)
    return max(200, vw), max(120, vh)

def _compute_autofit_sizes():
    global DISPLAY_W, DISPLAY_H
    n = _active_cam_count()
    if n <= 0:
        DISPLAY_W, DISPLAY_H = DEFAULT_FEED_W, DEFAULT_FEED_H
        return
    avail_w, avail_h = _canvas_avail_wh()
    usable_w = max(50, avail_w - CELL_GAP*(n+1))
    usable_h = max(50, avail_h - 10)
    aspect = max(0.1, float(DEFAULT_FEED_W)/float(DEFAULT_FEED_H))
    w_by_width = int(usable_w // n)
    h_by_width = int(w_by_width/aspect)
    h_by_height = int(usable_h - CELL_HEADER_H)
    w_by_height = int(h_by_height * aspect)
    w = min(w_by_width, w_by_height)
    h = int(w / aspect)
    w = max(120, min(1280, w))
    h = max(90,  min(720,  h))
    DISPLAY_W, DISPLAY_H = w, h

_last_autofit_sig = (-1,-1,-1)
def _autofit(force=False):
    if AUTO_FIT_VAR.get() != 1: return
    n = _active_cam_count()
    vw, vh = _canvas_avail_wh()
    global _last_autofit_sig
    sig = (n, vw, vh)
    if force or sig != _last_autofit_sig:
        _compute_autofit_sizes()
        for idx, (cell, lbl) in camera_cells.items():
            _apply_cell_size(cell, lbl, DISPLAY_W, DISPLAY_H)
        video_strip.update_idletasks()
        _update_video_scroll()
        _last_autofit_sig = sig

video_canvas.bind("<Configure>", lambda e: _autofit(force=ALWAYS_AUTOFIT_VAR.get()==1))


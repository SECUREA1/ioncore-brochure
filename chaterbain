def _ensure_default_templates():
    if not os.path.exists(TEMPLATES_FILE):
        _save_json(TEMPLATES_FILE, _DEFAULT_TEMPLATES)

class TemplateStore:
    def __init__(self):
        _ensure_default_templates()
        self.data = _load_json(TEMPLATES_FILE, _DEFAULT_TEMPLATES)
        self.templates = self.data.get("templates", {})

    def save(self):
        self.data["templates"] = self.templates
        _save_json(TEMPLATES_FILE, self.data)

    def list_ids(self) -> List[str]:
        return sorted(self.templates.keys())

    def get(self, tid: str) -> Dict[str, Any]:
        return dict(self.templates.get(tid, {}))

    def set(self, tid: str, payload: Dict[str, Any]):
        self.templates[tid] = payload
        self.save()

    def delete(self, tid: str):
        if tid in self.templates:
            self.templates.pop(tid, None)
            self.save()

    def pick(self, tid: str, style: str, ctx: Dict[str, Any], temperature: float = 0.7) -> str:
        tpl = self.templates.get(tid) or {}
        variants = tpl.get("variants") or []
        if not variants:
            return ""
        # style filtering if present
        styles = tpl.get("styles") or []
        if styles and (style not in styles):
            # if mismatch, allow anyway (don’t go silent)
            pass
        # temperature influences randomness slightly
        if len(variants) == 1:
            chosen = variants[0]
        else:
            # Weighted-ish: cooler temps bias toward first items.
            t = max(0.0, min(1.0, float(temperature)))
            if t < 0.35:
                idx = int((1.0 - t) * 0.5 * (len(variants)-1))
                idx = max(0, min(len(variants)-1, idx))
                chosen = variants[idx]
            else:
                chosen = random.choice(variants)
        return render_template(chosen, ctx)


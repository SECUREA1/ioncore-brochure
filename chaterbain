    row(sec_sys, 3, "Frame Skip", "skip")

    for c in range(3): sec_tot.columnconfigure(c, weight=1)
    row(sec_tot, 0, "Persons (all)",  "persons",         review_cmd=lambda: open_review_popup("persons_all"))

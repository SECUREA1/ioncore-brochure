# ========== tuner & loops state ==========
class Tuner:
    def __init__(self):
        self.voice_enabled = True
        self.narrate_persons = True
        self.narrate_objects = True
        self.narrate_vehicles = True
        self.muted_labels = set()
        self.global_cooldown = 3.0
        self.per_key_cooldown = 10.0
        self._last_any = 0.0
        self._last_key = {}
        self._recent_labels = deque(maxlen=6)
        # connector memory
        self.prev_obj: Optional[str] = None
        self.prev_kw: List[str] = []
        self.prev_sent: str = "NEUTRAL"

    def should_speak(self): return self.voice_enabled
    def muted(self, label: str, kind: str) -> bool:
        l = label.lower()
        if kind == "person": return (not self.narrate_persons) or (l in self.muted_labels) or ("person" in self.muted_labels)
        if kind == "vehicle": return (not self.narrate_vehicles) or (l in self.muted_labels)
        return (not self.narrate_objects) or (l in self.muted_labels)
    def under_global_cd(self): return (time.time() - self._last_any) < self.global_cooldown
    def under_key_cd(self, key): return (time.time() - self._last_key.get(key, 0.0)) < self.per_key_cooldown
    def mark_any(self): self._last_any = time.time()
    def mark_key(self, key): self._last_key[key] = time.time()
    def seen_recent(self, label: str) -> bool:
        l = label.lower()
        if l in self._recent_labels: return True
        self._recent_labels.append(l); return False

# ========== camera worker (loop feed per camera) ==========
class CameraWorker:
    def __init__(self, source):
        self.source = source
        self.cap = None
        self.lock = Lock()
        self.running = False
        self.latest = None   # latest BGR frame

    def start(self):
        self.running = True
        self.cap = cv2.VideoCapture(self.source)
        Thread(target=self._loop, daemon=True).start()

    def stop(self):
        self.running = False
        try:
            if self.cap and self.cap.isOpened(): self.cap.release()
        except Exception: pass

    def _loop(self):
        # loop feed for this camera: continually refresh .latest
        while self.running:
            ok, frame = self.cap.read()
            if ok:
                with self.lock:
                    self.latest = frame
            else:
                # try reopen a bit later
                time.sleep(0.5)
                try:
                    if self.cap: self.cap.release()
                except Exception: pass
                self.cap = cv2.VideoCapture(self.source)
            time.sleep(0.01)  # throttle

    def get_frame(self):
        with self.lock:
            return None if self.latest is None else self.latest.copy()


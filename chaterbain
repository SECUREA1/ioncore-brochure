def online_chat_response(prompt: str, system="You are a concise, friendly assistant.") -> Optional[str]:
    if not OPENAI_API_KEY: return None
    try:
        headers = {"Authorization": f"Bearer {OPENAI_API_KEY}", "Content-Type": "application/json"}
        payload = {"model": OPENAI_MODEL, "messages":[{"role":"system","content":system},{"role":"user","content":prompt}], "temperature":0.8}
        r = requests.post("https://api.openai.com/v1/chat/completions", headers=headers, json=payload, timeout=25)
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip()
    except Exception:
        return None

def lightweight_chat_response(user_text: str, context: str = "") -> str:
    t = (user_text or "").lower()
    if any(q in t for q in ["what","where","who","which","how many","when","?"]):
        return "From what I can tell: " + (context or "no special context right now.")
    if "hello" in t or "hi" in t: return "Hi! How can I help?"
    if "thank" in t: return "You’re welcome!"
    return "Okay."


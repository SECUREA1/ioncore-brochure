last_narrated = defaultdict(float)

def should_narrate(kind, label):
    if mute_rules["global_mute"] or (not comms_state["auto_narrate"]):
        return False
    if kind == "person":
        if mute_rules["mute_persons"] or (not comms_state["narrate_persons"]): return False
        if label in set(mute_rules["persons"]): return False
    elif kind == "vehicle":
        if mute_rules["mute_vehicles"] or (not comms_state["narrate_vehicles"]): return False
        if label in set(mute_rules["vehicles"]): return False
    else:
        if mute_rules["mute_objects"] or (not comms_state["narrate_objects"]): return False
        if label in set(mute_rules["objects"]): return False
    key = f"{kind}:{label}"
    now = time.time()
    if (now - last_narrated[key]) < comms_state["narrate_min_interval"]:
        return False
    last_narrated[key] = now
    return True

VEHICLE_LABELS = {"car","bus","truck","motorbike","bicycle","train","boat","aeroplane","airplane"}

def process_frame(frame, cam_name):
    # Faces
    faces = identify_faces(frame) if face_enabled else []
    for (x,y,w,h), name, _ in faces:
        cv2.rectangle(frame, (x,y), (x+w,y+h), (0,255,0), 2)
        cv2.putText(frame, f"{name}", (x, max(0,y-8)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,0), 2)
        person_memory[name].append({"time": time.time(), "camera": cam_name, "box": (x,y,w,h)})
        tracked_persons.add(name)
        if should_narrate("person", name):
            chat_add("AI", f"I see {name} on {cam_name}.", speak_flag=True)

    # YOLO objects
    boxes, confs, cids = run_yolo(frame)
    for (x,y,w,h), conf, cid in zip(boxes, confs, cids):
        label = yolo_classes[cid] if cid < len(yolo_classes) else f"id{cid}"
        color = ensure_color_pool(label)
        cv2.rectangle(frame, (x,y), (x+w, y+h), color, 2)
        cv2.putText(frame, f"{label} {int(conf*100)}%", (x, max(0,y-8)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
        current_detections.append((cam_name, label, x,y,w,h, conf))
        recent_detection_times.append(time.time())
        # memory
        object_memory[label].append({"time": time.time(), "camera": cam_name, "box": (x,y,w,h), "status": "Seen", "conf": float(conf)})
        tracked_objects.add(label)
        # narrate per muting rules
        kind = "vehicle" if label in VEHICLE_LABELS else "object"
        if should_narrate(kind, label):
            if kind == "vehicle":
                chat_add("AI", f"Vehicle detected ({label}) on {cam_name}.", speak_flag=True)
            else:
                chat_add("AI", f"{label} on {cam_name}.", speak_flag=True)

    return frame

def refresh_lists():
    # objects
    items = sorted(tracked_objects)
    objects_list.delete(0, tk.END)
    for it in items: objects_list.insert(tk.END, it)
    # persons
    items = sorted(tracked_persons)

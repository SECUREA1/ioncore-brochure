def init_yolo():
    global yolo_enabled, yolo_net, yolo_out_layers, yolo_classes
    if not (os.path.exists(YOLO_CFG) and os.path.exists(YOLO_WEIGHTS) and os.path.exists(YOLO_NAMES)):
        log.warning("YOLO files not found. Object detection disabled.")
        yolo_enabled = False
        return
    try:
        with open(YOLO_NAMES, "r") as f:
            yolo_classes[:] = [ln.strip() for ln in f if ln.strip()]
        yolo_net = cv2.dnn.readNet(YOLO_WEIGHTS, YOLO_CFG)
        try:
            yolo_net.setPreferableBackend(cv2.dnn.DNN_BACKEND_CUDA)
            yolo_net.setPreferableTarget(cv2.dnn.DNN_TARGET_CUDA)
            log.info("YOLO using CUDA.")
        except Exception:
            yolo_net.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)
            yolo_net.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)
            log.info("YOLO using CPU.")
        layer_names = yolo_net.getLayerNames()
        yolo_out_layers[:] = [layer_names[i-1] for i in yolo_net.getUnconnectedOutLayers().flatten()]
        yolo_enabled = True
    except Exception as e:
        log.error(f"YOLO init error: {e}")
        yolo_enabled = False

init_yolo()

def run_yolo(frame):
    if not yolo_enabled: return [], [], []
    H, W = frame.shape[:2]
    blob = cv2.dnn.blobFromImage(frame, 1/255.0, (416,416), swapRB=True, crop=False)
    yolo_net.setInput(blob)
    outs = yolo_net.forward(yolo_out_layers)
    boxes, confs, cids = [], [], []
    for out in outs:
        for det in out:
            scores = det[5:]
            cid = int(np.argmax(scores))
            score = float(scores[cid])
            obj = float(det[4])
            conf = obj*score
            if conf >= YOLO_CONF:
                cx, cy, ww, hh = det[0]*W, det[1]*H, det[2]*W, det[3]*H
                x = int(cx - ww/2); y = int(cy - hh/2)
                boxes.append([x,y, int(ww), int(hh)])
                confs.append(conf)
                cids.append(cid)
    idxs = cv2.dnn.NMSBoxes(boxes, confs, YOLO_CONF, YOLO_NMS)
    fb, fc, fi = [], [], []
    if len(idxs) > 0:
        for i in idxs.flatten():
            fb.append(boxes[i]); fc.append(confs[i]); fi.append(cids[i])
    return fb, fc, fi

